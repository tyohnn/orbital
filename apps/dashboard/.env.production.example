# production(Vercel 의 Production 배포, https://orbital-dashboard-pax-humaana.vercel.app)의 환경 변수입니다.
# 이 파일을 .env.production 으로 옮겨 값을 채운 뒤, Vercel 프로젝트 orbital-dashboard 의
# Environment Variables 에 Production 으로 넣습니다.
# ⚠ .env.production 은 커밋하지 않습니다(.gitignore). 이 파일에는 키와 주석만 둡니다.
# ⚠ .env.production 은 로컬의 `next build` · `next start` 도 읽습니다. 운영 값으로 로컬 빌드를 돌리지 않도록 조심합니다.

# ── Supabase Auth(로그인은 Google) ────────────────────────────
# 운영 Supabase 프로젝트 `orbital` 의 주소. 예: https://<프로젝트 ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# 그 프로젝트의 publishable 키(sb_publishable_…). 브라우저에 나가도 되는 키입니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 대시보드의 기록 ───────────────────────────────────────────
# Supabase 의 Connect → Transaction pooler 문자열(비밀번호 포함). Vercel 에는 Sensitive 로 넣습니다.
DASHBOARD_DATABASE_URL=

# ── 팩토리 키의 봉인 ──────────────────────────────────────────
# openssl rand -hex 32. ⚠ 한 번 정하면 바꾸지 않습니다. 바꾸면 이미 봉인한 팩토리의 키를 풀지 못합니다.
DASHBOARD_SEAL_KEY=

# ── 관리 서버(orbitald, GCP 서울) ─────────────────────────────
# 운영 orbitald 의 바탕 주소(https, 끝에 / 와 /v1 없이). 예: https://api.<IP>.sslip.io
ORBITAL_URL=
# 운영 orbitald 의 ORBITAL_ADMIN_KEY 와 같은 값. Vercel 에는 Sensitive 로 넣습니다.
ORBITAL_ADMIN_KEY=

# ⚠ ALLOW_LOCAL_ACCOUNTS 는 운영에 넣지 않습니다.
