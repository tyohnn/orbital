# 로컬 개발(next dev, 포트 7600)의 환경 변수입니다. 이 파일을 .env.local 로 옮겨 값을 채웁니다.
# ⚠ .env.local 은 커밋하지 않습니다(.gitignore). 이 파일에는 키와 주석만 둡니다.

# ── Supabase Auth ─────────────────────────────────────────────
# 로컬 Supabase 의 API 주소. apps/dashboard 에서 `npx supabase start` 를 하면 54421 에 섭니다.
# 예: http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_URL=
# 로컬 Supabase 의 anon 키. `npx supabase status` 의 anon key 를 그대로 넣습니다(로컬 공용 데모 키).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 대시보드의 기록(팩토리 · 팀원 · 초대) ───────────────────────
# 로컬 Supabase 의 DB. 비우면 개발에서만 메모리에 두고, 서버가 다시 뜨면 사라집니다.
# 예: postgres://postgres:postgres@127.0.0.1:54422/postgres
DASHBOARD_DATABASE_URL=

# ── 팩토리 키의 봉인 ──────────────────────────────────────────
# 대시보드가 쓰는 팩토리의 service key 를 AES-256-GCM 으로 봉인하는 열쇠(64자리 hex).
# 만드는 법: openssl rand -hex 32. 바꾸면 이미 봉인한 키를 풀지 못합니다.
DASHBOARD_SEAL_KEY=

# ── 관리 서버(orbitald) ───────────────────────────────────────
# orbitald 의 바탕 주소. 끝에 / 와 /v1 을 붙이지 않습니다(SDK 가 붙입니다).
# 로컬은 `cargo run -p orbital-server` 의 기본 주소입니다. 예: http://127.0.0.1:7400
ORBITAL_URL=
# orbitald 를 띄울 때 준 ORBITAL_ADMIN_KEY 와 같은 값(32바이트 이상). 이 서버에만 둡니다.
# 만드는 법: openssl rand -base64 48
ORBITAL_ADMIN_KEY=

# ── 로컬 계정 ────────────────────────────────────────────────
# next dev 에서는 시드 계정(비밀번호 orbital-local)의 이메일 · 비밀번호 로그인이 언제나 켜집니다.
# 프로덕션 빌드로 e2e 를 돌릴 때만 1 로 켭니다. ⚠ staging · production 에는 넣지 않습니다.
# ALLOW_LOCAL_ACCOUNTS=
