# Supabase Auth(운영은 Google, 로컬은 시드 계정의 이메일과 비밀번호)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54421
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 대시보드의 기록(팩토리 · 팀원 · 초대). 없으면 개발에서만 메모리에 둔다
DASHBOARD_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54422/postgres
# 대시보드가 쓰는 팩토리의 키를 봉인하는 열쇠. openssl rand -hex 32
DASHBOARD_SEAL_KEY=
# 관리 서버(orbitald)의 주소와 운영자 키. 운영자 키는 이 서버에만 둔다
ORBITAL_URL=http://127.0.0.1:7400
ORBITAL_ADMIN_KEY=
# 프로덕션 빌드에서 e2e 를 돌릴 때만 1. 배포 환경에는 넣지 않는다
# ALLOW_LOCAL_ACCOUNTS=1
