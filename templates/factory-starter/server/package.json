{
    "name": "starter-server",
    "version": "0.0.0",
    "private": true,
    "description": "팩토리의 서버. 플러그인의 도구가 닿고, service key 로 Orbital 을 부른다",
    "type": "module",
    "engines": {
        "node": ">=22.18"
    },
    "scripts": {
        "start": "node src/main.ts",
        "try": "node src/try.ts",
        "operator": "node src/operator.ts",
        "pack": "node src/pack.ts",
        "typecheck": "tsc --noEmit",
        "test": "node --test test/*.test.ts"
    },
    "dependencies": {
        "@harmony/orbital": "*",
        "@modelcontextprotocol/server": "2.4.0"
    },
    "devDependencies": {
        "@modelcontextprotocol/client": "2.4.0",
        "@types/node": "26.6.9",
        "typescript": "7.0.2"
    }
}
